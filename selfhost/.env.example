# Copy to .env and fill in the two required secrets below.
#
#   cp -n .env.example .env      # -n: never overwrite a live .env
#
# Every comment here is on its OWN line. Do not move one onto a value line:
# `KEY=value   # note` is parsed differently by different Compose versions, and
# a KEY that silently becomes empty takes the whole backend down at boot.

# ---- core (required) -------------------------------------------------------
MONGO_URL=mongodb://mongo:27017
DB_NAME=webminpulse

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 44 url-safe base64 characters. This key decrypts stored Webmin passwords -
# replacing it means re-entering them, so keep a copy somewhere safe.
SERVER_ENC_KEY=

POLL_INTERVAL_SECONDS=1800

# ---- Steam library scan ----------------------------------------------------
# Personal key from https://steamcommunity.com/dev/apikey (the app sends it per
# request; set here only if you want a server-side default).
STEAM_API_KEY=

# ---- game servers ----------------------------------------------------------
# Leave the SSH vars blank to run servers on the same box as the backend.
# Set them to drive a separate x86_64 "gameserver" while the backend lives
# elsewhere (e.g. on a Pi, which cannot run SteamCMD itself).

# e.g. gameserver.lan - blank = run servers locally
GAMESERVER_SSH_HOST=
GAMESERVER_SSH_USER=steam
GAMESERVER_SSH_PORT=22
# The key must be mounted into the container.
GAMESERVER_SSH_KEY=/keys/id_ed25519

# Install path ON THE GAMESERVER when SSH is set.
GAMESERVER_BASE_DIR=/opt/gameservers
STEAMCMD_PATH=steamcmd
# Steam account for Arma 3 / DayZ / Killing Floor, which reject anonymous
# SteamCMD. Log in by hand once so the credentials are cached.
STEAMCMD_LOGIN=

# Stop a server after this long with NOBODY on it.
GAMESERVER_IDLE_STOP_HOURS=12
# Ceiling for a single /extend.
GAMESERVER_MAX_EXTEND_HOURS=24
# Warn in Discord this long before an auto-stop.
GAMESERVER_WARN_BEFORE_MIN=15
# Seconds between SIGTERM and SIGKILL.
GAMESERVER_STOP_GRACE=30
# Longer grace when saving a world first.
GAMESERVER_SAVE_STOP_GRACE=120
# Warning players get before a requested stop.
GAMESERVER_STOP_NOTICE_SECONDS=300
# How often to ask servers who is online (hourly).
GAMESERVER_PLAYER_POLL_SECONDS=3600
# Who may stop an EMPTY server: starter | anyone
GAMESERVER_EMPTY_STOP_POLICY=starter

# ---- Windows-only servers via Proton/Wine ----------------------------------
# ARK: Survival Ascended, Space Engineers.
PROTON_PATH=/opt/proton/proton
WINE_PATH=wine
# Ubuntu: /usr/lib/x86_64-linux-gnu/wine/wineserver unless symlinked.
WINESERVER_PATH=wineserver
STEAM_COMPAT_CLIENT_INSTALL_PATH=/opt/steam

# ---- Discord bot -----------------------------------------------------------
# Leave DISCORD_BOT_TOKEN blank to disable the bot entirely.
DISCORD_BOT_TOKEN=
# Your Discord SERVER's id (not a channel) -> slash commands appear instantly.
DISCORD_GUILD_ID=
# The WebminPulse account the bot acts as.
DISCORD_OWNER_EMAIL=
# Channel for auto-stop warnings.
DISCORD_CHANNEL_ID=
# e.g. "Server Admin". Blank = anyone who can manage the Discord server
# counts as an admin.
DISCORD_ADMIN_ROLE=
