# ---- core (required) -------------------------------------------------------
MONGO_URL=mongodb://mongo:27017
DB_NAME=webminpulse
JWT_SECRET=                       # openssl rand -hex 32
SERVER_ENC_KEY=                   # python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POLL_INTERVAL_SECONDS=1800

# ---- Steam library scan ----------------------------------------------------
# Personal key from https://steamcommunity.com/dev/apikey (the app sends it per
# request; set here only if you want a server-side default).
STEAM_API_KEY=

# ---- game servers ----------------------------------------------------------
# Leave the SSH vars blank to run servers on the same box as the backend.
# Set them to drive a separate x86_64 "gameserver" while the backend lives
# elsewhere (e.g. on a Pi, which cannot run SteamCMD itself).
GAMESERVER_SSH_HOST=              # e.g. gameserver.lan - blank = run locally
GAMESERVER_SSH_USER=steam
GAMESERVER_SSH_PORT=22
GAMESERVER_SSH_KEY=/keys/id_ed25519    # key must be mounted into the container

GAMESERVER_BASE_DIR=/opt/gameservers   # install path ON THE GAMESERVER when SSH is set
STEAMCMD_PATH=steamcmd
GAMESERVER_AUTO_STOP_HOURS=12          # stop a server this long after it starts
GAMESERVER_MAX_EXTEND_HOURS=24         # ceiling for a single /extend
GAMESERVER_WARN_BEFORE_MIN=15          # warn in Discord this long before auto-stop
GAMESERVER_STOP_GRACE=30               # seconds between SIGTERM and SIGKILL

# ---- Discord bot (optional; leave DISCORD_BOT_TOKEN blank to disable) -------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=                 # your server's ID -> slash commands appear instantly
DISCORD_OWNER_EMAIL=              # the WebminPulse account the bot acts as
DISCORD_CHANNEL_ID=               # channel for auto-stop warnings
DISCORD_ALLOWED_ROLE=             # e.g. "Server Admin"; blank = anyone in the channel
